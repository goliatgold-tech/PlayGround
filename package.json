{
  "name": "pirate-rpg-slice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-World Pirate RPG - Web vertical slice (Three.js client + authoritative WebSocket server)",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "tsx src/server/world.test.ts",
    "start": "tsx src/server/index.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.12",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
